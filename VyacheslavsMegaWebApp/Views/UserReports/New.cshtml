@model UserReport

@{
    ViewData["Title"] = "Сообщить о сбое - Vyacheslav's Mega Server";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/report.css" asp-append-version="true" />
}

<div class="report-page">
    <div class="report-admin-peeker">
        <img src="~/img/report_admin.png" alt="Администратор VEC" class="report-admin-img" />
    </div>

    <div class="report-container">
        
        <div class="report-header">
            <span class="donation-hero__badge">СЛУЖБА ПОДДЕРЖКИ</span>
            <h1 class="donation-hero__title">
                СООБЩИТЬ О <span class="hero-title__accent">СБОЕ</span>
            </h1>
            <p class="donation-hero__desc">
                Не работает сервер или столкнулись с багом? Опишите проблему ниже — администрация изучит логи и оперативно устранит неполадку.
            </p>
        </div>

        <div class="report-card">
            <form class="report-form" method="post" asp-action="New">
                
                <div class="form__validation-summary" asp-validation-summary="All"></div>

                <div class="report-form-group">
                    <label class="report-label" asp-for="Subject">
                        <i class='bx bx-edit-alt'></i>
                        <span>Тема обращения</span>
                    </label>

                    <div class="report-control">
                        <div class="field">
                            <input class="field__input" asp-for="Subject" placeholder="Краткая суть проблемы" autofocus />
                        </div>
                    </div>
                    <span asp-validation-for="Subject" class="form-group__error"></span>
                </div>

                <div class="report-form-group">
                    <label class="report-label" asp-for="ReportText">
                        <i class='bx bx-message-square-detail'></i>
                        <span>Подробное описание проблемы</span>
                    </label>

                    <div class="report-control">
                        <div class="field">
                            <textarea class="field__input field__input--no-resize" 
                                      placeholder="Введите минимум 5 символов" 
                                      rows="7"
                                      asp-for="ReportText" 
                                      id="reportText"></textarea>
                        </div>
                    </div>

                    <div class="report-meta-row">
                        <span asp-validation-for="ReportText" class="form-group__error"></span>
                        <div class="form-group__hint report-counter" id="counter">
                            (<span id="current">0</span>&nbsp;/ <span>500</span> символов)
                        </div>
                    </div>
                </div>

                <div class="report-tips">
                    <i class='bx bx-info-circle'></i>
                    <div>
                        Если сбой произошёл в игре, рекомендуем указать ваш игровой никнейм и примерные координаты или время инцидента.
                    </div>
                </div>

                <div class="report-footer">
                    <button class="mc-button mc-button--wide" type="submit">
                        <span class="mc-button__title">Отправить обращение</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/report-text-counter.js"></script>