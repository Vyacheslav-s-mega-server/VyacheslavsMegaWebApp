@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Сброс пароля - Vyacheslav's Mega Server";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            
            <div class="auth-header">
                <h1 class="auth-title">СБРОС ПАРОЛЯ</h1>
                <p class="auth-subtitle">Введите никнейм или email для восстановления доступа.</p>
            </div>

            <form class="auth-form" asp-area="" asp-controller="Account" asp-action="ForgotPassword" method="post">
                
                <div class="form__validation-summary" asp-validation-summary="All"></div>

                <div class="auth-form-group">
                    <label class="auth-label" asp-for="UserInput">Никнейм или Email</label>
                    <div class="field">
                        <input class="field__input" asp-for="UserInput" placeholder="Steve" autocomplete="username" autofocus required />
                    </div>
                    <span class="form-error-msg" asp-validation-for="UserInput"></span>
                </div>

                <button type="submit" class="btn-download-auth">
                    <span>Сбросить пароль</span>
                </button>
            </form>

            <div class="auth-footer">
                <p><a asp-action="Login">Вернуться ко входу</a></p>
            </div>

        </div>
    </div>
</div>