@model ChangePasswordViewModel

<form class="form account-form" asp-controller="Account" asp-action="ChangePassword" id="changePasswordForm" method="post" style="max-width: 520px;">
    <div asp-validation-summary="All" class="mc-status-bar mc-status-bar--danger"></div>
    
    <div class="form-group" style="margin-bottom: 18px;">
        <label class="settings-field-label">Текущий пароль</label>
        <input class="field__input" asp-for="OldPassword" autocomplete="current-password" placeholder="Введите старый пароль" />
    </div>

    <div class="form-group" style="margin-bottom: 18px;">
        <label class="settings-field-label">Новый пароль</label>
        <input class="field__input" asp-for="NewPassword" autocomplete="new-password" placeholder="Минимум 6 символов" />
    </div>

    <div class="form-group" style="margin-bottom: 22px;">
        <label class="settings-field-label">Подтверждение нового пароля</label>
        <input class="field__input" asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Повторите новый пароль" />
    </div>

    <div>
        <button class="btn-download-auth" type="submit" style="width: auto; padding: 12px 28px;">
            <span>Обновить пароль</span>
        </button>
    </div>
</form>