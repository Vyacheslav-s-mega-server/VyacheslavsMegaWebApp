@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Новый пароль - Vyacheslav's Mega Server";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            
            <div class="auth-header">
                <h1 class="auth-title">НОВЫЙ ПАРОЛЬ</h1>
            </div>

            <form class="auth-form" asp-area="" asp-controller="Account" asp-action="ResetPassword" method="post">
                
                <div class="form__validation-summary" asp-validation-summary="All"></div>

                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />

                <div class="auth-form-group">
                    <label class="auth-label" asp-for="NewPassword">Новый пароль</label>
                    <div class="field">
                        <input class="field__input" asp-for="NewPassword" type="password" placeholder="••••••••" autocomplete="new-password" required />
                    </div>
                    <span class="form-error-msg" asp-validation-for="NewPassword"></span>
                </div>

                <div class="auth-form-group">
                    <label class="auth-label" asp-for="ConfirmPassword">Подтверждение пароля</label>
                    <div class="field">
                        <input class="field__input" asp-for="ConfirmPassword" type="password" placeholder="••••••••" autocomplete="new-password" required />
                    </div>
                    <span class="form-error-msg" asp-validation-for="ConfirmPassword"></span>
                </div>

                <button type="submit" class="btn-download-auth">
                    <span>Сменить пароль</span>
                </button>
            </form>

            <div class="auth-footer">
                <p><a asp-action="Login">Вернуться ко входу</a></p>
            </div>

        </div>
    </div>
</div>