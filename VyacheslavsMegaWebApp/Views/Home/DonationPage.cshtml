@model DonationPageViewModel

@{
    ViewData["Title"] = "Пожертвования - Vyacheslav's Mega Server";
}

<section class="donation-hero">
    <div class="donation-hero__container">
        <div class="donation-hero__grid">
            <div class="donation-hero__content">
                <span class="donation-hero__badge">ПОДДЕРЖКА ПРОЕКТА</span>
                <h1 class="donation-hero__title">
                    ПОЖЕРТВОВАНИЯ <span class="hero-title__accent">VEC</span>
                </h1>
                <p class="donation-hero__desc">
                    Vyacheslav's Mega Server — некоммерческий проект. Все добровольные пожертвования направляются напрямую на аренду мощного выделенного сервера, регулярные бэкапы, развитие и надёжную защиту.
                </p>

                <div class="donation-hero__features">
                    <div class="donation-feature-item">
                        <i class='bx bx-check-shield'></i>
                        <span>100% средств идут исключительно на развитие сервера</span>
                    </div>
                    <div class="donation-feature-item">
                        <i class='bx bx-wallet-alt'></i>
                        <span>Прямой перевод на карту без комиссии сторонних сервисов</span>
                    </div>
                    <div class="donation-feature-item">
                        <i class='bx bx-equalizer'></i>
                        <span>Честное выживание — игра без платных донат-привилегий</span>
                    </div>
                </div>

                <div class="donation-hero__actions">
                    <a href="#cards" class="btn-download">
                        <i class='bx bx-credit-card'></i>
                        <span>Реквизиты карт</span>
                    </a>
                    <a href="#fund" class="btn-secondary">
                        <i class='bx bx-target-lock'></i>
                        <span>Цель фонда</span>
                    </a>
                </div>
            </div>

            <div class="donation-hero__visual">
                <div class="donation-char-wrapper">
                    <div class="donation-char-aura"></div>
                    <img class="donation-char-img" src="~/img/vyacheslav-money.png" alt="Вячеслав с монетами" />
                    <div class="donation-char-chip">
                        <div class="donation-chip-text">
                            <span class="donation-chip-label">ТЕКУЩАЯ ЦЕЛЬ</span>
                            <span class="donation-chip-value">@Model.Goal.Name</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.HasCards)
{
    <section class="donation-cards-section" id="cards">
        <div class="donation-hero__container">
            <div class="donation-section-head">
                <span class="donation-section-tag">РЕКВИЗИТЫ</span>
                <h2 class="donation-section-title">Банковские карты для поддержки</h2>
                <p class="donation-section-desc">Нажмите на номер карты или кнопку копирования для быстрого перевода через мобильное приложение вашего банка:</p>
            </div>

            <div class="donation-cards-grid">
                @foreach (DonationCard card in Model.DonationCards)
                {
                    <div class="donation-bank-card" 
                         style="background: linear-gradient(45deg, @card.ColorDownLeft, @card.ColorUpRight);"
                         onclick="copyCardNumber(event, '@card.CardNumderNormalized')">
                        
                        <div class="card-top-row">
                            <div class="card-chip-group">
                                <div class="card-emv-chip"></div>
                                <i class='bx bx-wifi card-nfc-icon'></i>
                            </div>
                            <span class="card-bank-name">@card.BankName</span>
                        </div>

                        <div class="card-mid-row">
                            <p class="card-number-text">@card.CardNumber</p>
                            <div class="card-copy-pill" onclick="copyCardNumber(event, '@card.CardNumderNormalized')">
                                <i class='bx bx-copy'></i>
                                <span>Скопировать номер</span>
                            </div>
                        </div>

                        <div class="card-bottom-row">
                            <div class="card-holder-group">
                                <span class="card-holder-label">Владелец карты</span>
                                <span class="card-holder-name">@card.CardHolder</span>
                            </div>
                            <span class="card-system-brand">@card.CardName</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="donation-fund-section" id="fund">
    <div class="donation-hero__container">
        <div class="donation-section-head">
            <span class="donation-section-tag">ПРОЗРАЧНОСТЬ</span>
            <h2 class="donation-section-title">Состояние фонда и сборов</h2>
            <p class="donation-section-desc">Вся статистика открыта для сообщества — следите за прогрессом сбора на апгрейды инфраструктуры:</p>
        </div>

        <div class="fund-stats-grid">
            <div class="fund-stat-card">
                <div class="fund-stat-body">
                    <span class="fund-stat-label">Собрано в фонде</span>
                    <span class="fund-stat-val">@Model.FundAmount.ToString("N0") ₸</span>
                </div>
            </div>

            <div class="fund-stat-card">
                <div class="fund-stat-body">
                    <span class="fund-stat-label">Стоимость цели</span>
                    <span class="fund-stat-val">@(Model.Goal.Price == 0 ? "Пока не задана" : Model.Goal.Price.ToString("N0") + " ₸")</span>
                </div>
            </div>

            <div class="fund-stat-card">
                <div class="fund-stat-body">
                    <span class="fund-stat-label">Текущая цель</span>
                    <span class="fund-stat-val">@Model.Goal.Name</span>
                </div>
            </div>
        </div>

        <div class="fund-progress-card">
            <h3 class="fund-progress-title">Шкала прогресса цели: @Model.Goal.Name</h3>

            <div class="mc-bar donation-fund__bar">
                <div class="mc-bar__text" id="xpText">0/100</div>
                <div class="mc-bar__progress" id="xpBar"></div>

                <input id="fundCurrent" type="hidden" value="@Model.FundAmount" />
                <input id="goalPrice" type="hidden" value="@Model.Goal.Price" />
            </div>
        </div>

        <div class="fund-table-card">
            <h3 class="fund-table-title">Последние транзакции фонда:</h3>
            <div class="mc-table-container">
                <table class="mc-table mc-table--wide">
                    <tr class="mc-table--center-aligment">
                        <td>Сумма</td>
                        <td>Назначение</td>
                        <td>Доп. информация</td>
                    </tr>

                    @if (Model.LastTransactions.Count == 0)
                    {
                        <tr class="mc-table--center-aligment">
                            <td colspan="3">Транзакций пока не было</td>
                        </tr>
                    }
                    else
                    {
                        foreach (FundTransaction transaction in Model.LastTransactions)
                        {
                            <tr>
                                <td class="mc-table--center-aligment">+@transaction.Amount ₸</td>
                                <td>@transaction.Purpose?.Name</td>
                                <td>@(string.IsNullOrWhiteSpace(transaction.Note) ? "—" : transaction.Note)</td>
                            </tr>
                        }
                        <tr class="mc-table--center-aligment">
                            <td colspan="3">
                                <a asp-controller="Home" asp-action="TransactionsHistory">Остальные транзакции</a>
                            </td>
                        </tr>
                    }
                </table>
            </div>
        </div>
    </div>
</section>

<script src="~/js/donation-progress.js"></script>
<script src="~/js/copy-card-number.js"></script>