@model ContactsEditorViewModel

<div class="block block--first">
    <div class="container">
        <div class="section">
            <h2 class="section__title section__title--main">Редактор контактов</h2>

            <div class="mc-table-container">
                <table class="mc-table mc-table--wide">
                    <tr class="mc-table--center-aligment">
                        <td>Имя пользователя</td>
                        <td>Отображаемое имя</td>
                        <td>Описание</td>
                        <td colspan="3">Действия</td>
                    </tr>
                    @foreach (Contact contact in Model.Contacts)
                    {
                        <tr>
                            <td>@(contact.User != null ? contact.User.UserName : contact.DisplayName)</td>
                            <td>@contact.DisplayName</td>
                            <td>@contact.Description</td>
                            <td><a asp-action="ContactDetails" asp-route-contactId="@contact.Id">Редактировать</a></td>
                            <td><a asp-action="ContactLinks" asp-route-contactId="@contact.Id">Редактировать ссылки</a></td>
                            <td><a asp-action="RemoveContact" asp-route-contactId="@contact.Id" onclick="confirmRemove(event)">Удалить</a></td>
                        </tr>
                    }
                    <tr class="mc-table--center-aligment">
                        <td colspan="6"><a asp-action="ContactDetails">Добавить контакт</a></td>
                    </tr>
                </table>
            </div>

            <p class="back-link">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Назад</a>
            </p>
        </div>
    </div>
</div>

<script src="~/js/navigation-confirmation.js"></script>