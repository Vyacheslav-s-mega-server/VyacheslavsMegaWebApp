@model Contact

<div class="block block--first">
    <div class="container">

        <div class="form-container">
            <form class="form" asp-area="Admin" asp-controller="ContactsEditor" asp-action="ContactDetails" method="post">

                <div class="form__header">
                    <h2 class="form__title form__title--main">@(Model.Id == 0 ? "Добавление" : "Редактирование") контакта</h2>
                </div>

                <input type="hidden" asp-for="Id" readonly />

                <div class="form__body">

                    <div class="form__validation-summary" asp-validation-summary="All"></div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="DisplayName"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="DisplayName">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Description"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Description">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="DescriptionLarge"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <textarea class="field__input" rows="4" asp-for="DescriptionLarge"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="UserId"></label>
                        <select class="mc-listbox"
                                asp-for="UserId"
                                asp-items="ViewBag.SelectUserItems"
                                size="5">
                        </select>
                    </div>

                    <div class="form-group">
                        <div class="form-group__control">
                            <label class="mc-checkbox">
                                <input class="mc-checkbox__input" asp-for="ShowContact">
                                <span class="mc-checkbox__box"></span>
                                <span class="mc-checkbox__label">@Html.DisplayNameFor(x => x.ShowContact)</span>
                            </label>
                        </div>
                    </div>

                </div>

                <div class="form__footer">
                    <button class="mc-button mc-button--wide" type="submit">
                        <span class="mc-button__title">Сохранить</span>
                    </button>

                    <p><a asp-area="Admin" asp-controller="ContactsEditor" asp-action="Index">Назад</a></p>
                </div>

            </form>
        </div>
    </div>
</div>