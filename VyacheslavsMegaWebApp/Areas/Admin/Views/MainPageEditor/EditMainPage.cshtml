@model MainPageData

<div class="block block--first">
    <div class="container">
        <div class="form-container">
            <form class="form" asp-area="Admin" asp-controller="MainPageEditor" asp-action="EditMainPage">

                <div class="form__header">
                    <h2 class="form__title form__title--main">Управление главной страницей VEC</h2>
                </div>

                <input type="hidden" asp-for="Id" readonly />
                <input type="hidden" asp-for="YellowHint" />
                <input type="hidden" asp-for="Description" />
                <input type="hidden" asp-for="ServerVersion" />
                <input type="hidden" asp-for="ErrorMessage" />
                <input type="hidden" asp-for="ShowErrorMessage" />

                <div class="form__body">

                    <div class="form__validation-summary" asp-validation-summary="All"></div>

                    <h3 class="section__title" style="margin-top: 10px; margin-bottom: 12px; font-size: 15px; color: #ffaa00; text-transform: uppercase;">1. Первый экран (Hero)</h3>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Title">Главный заголовок (строка 1)</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Title" placeholder="ОТКРОЙ СВОЙ">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="TitleAccent">Акцентный заголовок (строка 2, жёлтый)</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="TitleAccent" placeholder="ИДЕАЛЬНЫЙ МИР">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Subtitle">Подзаголовок первого экрана</label>
                        <div class="form-group__control">
                            <div class="field">
                                <textarea class="field__input" rows="3" asp-for="Subtitle" placeholder="Мега Сервер Вячеслава — уникальный мир Minecraft..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="ServerAddress">Адрес сервера (IP:Port)</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="ServerAddress" placeholder="95.59.233.227:25565">
                            </div>
                        </div>
                    </div>

                    <h3 class="section__title" style="margin-top: 24px; margin-bottom: 12px; font-size: 15px; color: #ffaa00; text-transform: uppercase;">2. Блок «О проекте VEC»</h3>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="AboutTag">Бейдж блока</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="AboutTag" placeholder="О ПРОЕКТЕ VEC">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="AboutTitle">Заголовок блока</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="AboutTitle" placeholder="Сервер, сделанный для людей">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="AboutText">Текст описания (поддерживает ссылки и теги)</label>
                        <div class="form-group__control">
                            <div class="field">
                                <textarea class="field__input" rows="3" asp-for="AboutText"></textarea>
                            </div>
                        </div>
                    </div>

                    <h3 class="section__title" style="margin-top: 24px; margin-bottom: 12px; font-size: 15px; color: #ffaa00; text-transform: uppercase;">3. Карточки преимуществ</h3>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Feature1Title">Карточка 1: Заголовок</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Feature1Title" placeholder="Собственный лаунчер VEC">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Feature1Desc">Карточка 1: Описание</label>
                        <div class="form-group__control">
                            <div class="field">
                                <textarea class="field__input" rows="2" asp-for="Feature1Desc"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Feature2Title">Карточка 2: Заголовок</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Feature2Title" placeholder="Честная игра без донат-мусора">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Feature2Desc">Карточка 2: Описание</label>
                        <div class="form-group__control">
                            <div class="field">
                                <textarea class="field__input" rows="2" asp-for="Feature2Desc"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Feature3Title">Карточка 3: Заголовок</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Feature3Title" placeholder="Стабильность и защита">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Feature3Desc">Карточка 3: Описание</label>
                        <div class="form-group__control">
                            <div class="field">
                                <textarea class="field__input" rows="2" asp-for="Feature3Desc"></textarea>
                            </div>
                        </div>
                    </div>

                    <h3 class="section__title" style="margin-top: 24px; margin-bottom: 12px; font-size: 15px; color: #ffaa00; text-transform: uppercase;">4. Карточка Вячеслава (Создатель)</h3>

                    <p style="font-size: 13px; color: #aaa; margin-bottom: 15px; line-height: 1.5;">
                        Цитата и контакты Вячеслава берутся из карточки основателя.<br>
                        <a asp-area="Admin" asp-controller="ContactsEditor" asp-action="ContactDetails" asp-route-contactId="1" style="color: #ffaa00; text-decoration: underline; font-weight: bold;">
                            → Редактировать цитату и соцсети Вячеслава
                        </a>
                    </p>

                    <h3 class="section__title" style="margin-top: 24px; margin-bottom: 12px; font-size: 15px; color: #ffaa00; text-transform: uppercase;">5. SEO и вкладка браузера</h3>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="PageTitle">Title вкладки браузера</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="PageTitle">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="MetatagDescription">Метатег Description</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="MetatagDescription">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="MetatagKeywords">Метатег Keywords</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="MetatagKeywords">
                            </div>
                        </div>
                    </div>

                </div>

                <div class="form__footer">
                    <button class="mc-button mc-button--wide" type="submit">
                        <span class="mc-button__title">Сохранить изменения</span>
                    </button>

                    <p><a asp-area="Admin" asp-controller="Home" asp-action="Index">Назад</a></p>
                </div>
            </form>
        </div>
    </div>
</div>