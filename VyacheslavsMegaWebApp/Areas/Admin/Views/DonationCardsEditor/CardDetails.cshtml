@model DonationCard

<div class="block block--first">
    <div class="container">

        <div class="form-container">
            <form class="form" asp-area="Admin" asp-controller="DonationCardsEditor" asp-action="CardDetails" method="post">

                <div class="form__header">
                    <h2 class="form__title form__title--main">@(Model.Id == 0 ? "Добавление" : "Редактирование") карты</h2>
                </div>

                <input type="hidden" asp-for="Id" readonly />

                <div class="form__body">

                    <div class="form__validation-summary" asp-validation-summary="All"></div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="CardName"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="CardName">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="BankName"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="BankName">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="CardNumber"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="CardNumber">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="CardHolder"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="CardHolder">
                            </div>
                        </div>
                    </div>

                    <div class="form__row">
                        <div class="form-group form-group--parent form-group--size-50">
                            
                            <div class="form-group">
                                 <label class="form-group__label" asp-for="ColorDownLeft"></label>

                                <div class="color-field form__row form__row--no-adaptivity">
                                    <div class="form-group__control">
                                        <div class="field">
                                            <input class="field__input color-field__hex" id="colorDownLeft" asp-for="ColorDownLeft" />
                                        </div>
                                    </div>
                                    <input class="color-field__picker" type="color" />
                                    <button class="mc-button color-field__btn" type="button">
                                        <span class="mc-button__title">🎨</span>
                                    </button>
                                </div>
                            </div>
                                
                            <div class="form-group">
                                <label class="form-group__label" asp-for="ColorUpRight"></label>

                                <div class="color-field form__row form__row--no-adaptivity">
                                    <div class="form-group__control">
                                        <div class="field">
                                            <input class="field__input color-field__hex" id="colorUpRight" asp-for="ColorUpRight" />
                                        </div>
                                    </div>
                                    <input class="color-field__picker" type="color" />
                                    <button class="mc-button color-field__btn" type="button">
                                        <span class="mc-button__title">🎨</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="form-group form-group--card-container">
                            <div class="card" id="cardExample" style="background: linear-gradient(45deg, #000000, #000000);">
                                <div class="card__header">
                                    <span>BankName</span>
                                </div>
                                <div class="card__body">
                                    <p class="card__number">1234 5678 9012 3456</p>
                                </div>
                                <div class="card__footer">
                                    <span>CARDHOLDER</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form__footer">
                    <button class="mc-button mc-button--wide" type="submit">
                        <span class="mc-button__title">Сохранить</span>
                    </button>

                    <p><a asp-area="Admin" asp-controller="DonationCardsEditor" asp-action="Index">Назад</a></p>
                </div>

            </form>
        </div>
    </div>
</div>

<script src="~/js/mc-color-picker.js"></script>
<script>
    const colorUpRightInput = document.getElementById("colorUpRight");
    const colorDownLeftInput = document.getElementById("colorDownLeft");
    const cardExample = document.getElementById("cardExample");

    document.querySelectorAll('.color-field__picker').forEach(picker => {
        picker.addEventListener('input', updateColors);
    });

    document.querySelectorAll('.color-field__hex').forEach(hexInput => {
        hexInput.addEventListener('input', updateColors);
    });

    window.addEventListener("load", updateColors);

    function updateColors(event) {
        let colorUpRight = colorUpRightInput.value;
        let colorDownLeft = colorDownLeftInput.value;
        cardExample.style.background = `linear-gradient(45deg, ${colorDownLeft}, ${colorUpRight})`;
    }
</script>