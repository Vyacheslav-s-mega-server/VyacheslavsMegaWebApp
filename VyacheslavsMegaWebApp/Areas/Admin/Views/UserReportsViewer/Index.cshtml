@model UserReportsViewerViewModel

<div class="block block--first">
    <div class="container">

        <div class="form-container">
            <form class="form" asp-area="Admin" asp-controller="UserReportsViewer" asp-action="RemoveSelected" method="post">

                <div class="form__header">
                    <h2 class="form__title form__title--main">Отчёты пользователей</h2>
                </div>

                <div class="form__body">

                    <div class="form__validation-summary" asp-validation-summary="All"></div>

                    <div class="form-group">
                        <div class="form__row">
                            <div class="form-group form-group--size-66">
                                <div class="form-group">
                                    <label class="form-group__label">Тема</label>
                                    <div class="form-group__control">
                                        <div class="field">
                                            <input class="field__input" id="reportSubject" readonly />
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="form-group__label">Описание проблемы</label>
                                    <div class="form-group__control">
                                        <div class="field">
                                            <textarea class="field__input field__input--no-resize" rows="6" id="reportText" readonly></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="element_label mc_form_font_standart"
                                        asp-for="ReportsId"></label>
                                <div class="form-group__control form-group__control--maximized">
                                <select class="mc-listbox"
                                        asp-for="SelectedReportId"
                                        asp-items="Model.ReportsId"
                                        id="reportId"
                                        size="2"
                                        onclick="updateTextarea()"
                                        onchange="updateTextarea()">
                                </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form__footer">
                    <button class="mc-button mc-button--wide" type="submit" id="submit">
                        <span class="mc-button__title">Удалить выбранный</span>
                    </button>

                    <p><a asp-area="Admin" asp-controller="Home" asp-action="Index">Назад</a></p>
                </div>

            </form>    
        </div>
    </div>
</div>

<script>
    const Reports = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.ReportsData.Select(r => new
        {
            r.Id,
            r.Subject,
            r.ReportText
        })
        ));
</script>
<script src="~/js/report-viewer.js"></script>