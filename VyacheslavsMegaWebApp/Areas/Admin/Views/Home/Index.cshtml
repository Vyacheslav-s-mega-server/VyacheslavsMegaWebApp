<div class="block block--first">
    <div class="container">
        <div class="admin-index">
            <h1 class="admin-index__title">Панель администратора</h1>
            <div class="section">
                <h2 class="section__title">Информация на сайте</h2>
                <div class="button-container">
                    <a asp-area="Admin" asp-controller="MainPageEditor" asp-action="EditMainPage">
                        <button class="mc-button mc-button--wide">
                            <span class="mc-button__title">Редактировать главную страницу</span>
                        </button>
                    </a>
                    <a asp-area="Admin" asp-controller="DownloadButtons" asp-action="Index">
                        <button class="mc-button mc-button--wide">
                            <span class="mc-button__title">Редактировать кнопки загрузок</span>
                        </button>
                    </a>
                    <a asp-area="Admin" asp-controller="ServerMediaEditor" asp-action="Index">
                        <button class="mc-button mc-button--wide">
                            <span class="mc-button__title">Редактировать соц. сети сервера</span>
                        </button>
                    </a>
                    <a asp-area="Admin" asp-controller="ContactsEditor" asp-action="Index">
                        <button class="mc-button mc-button--wide">
                            <span class="mc-button__title">Редактировать контакты</span>
                        </button>
                    </a>
                    <a asp-area="Admin" asp-controller="PartnersEditor" asp-action="Index">
                        <button class="mc-button mc-button--wide">
                            <span class="mc-button__title">Редактировать партнёров</span>
                        </button>
                    </a>
                </div>
            </div>

            <div class="section">
                <h2 class="section__title">Игровой клиент и гардероб</h2>
                <div class="button-container">
                    <a asp-area="Admin" asp-controller="ClientBuildsEditor" asp-action="Index">
                        <button class="mc-button mc-button--wide">
                            <span class="mc-button__title">Управление клиентом (Моды, Шейдеры, Ресурспаки)</span>
                        </button>
                    </a>
                    <a asp-area="Admin" asp-controller="CapesEditor" asp-action="Index">
                        <button class="mc-button mc-button--wide">
                            <span class="mc-button__title">Редактор плащей и промокодов</span>
                        </button>
                    </a>
                </div>
            </div>

            <div class="section">
                <h2 class="section__title">Пользователи</h2>
                <div class="button-container">
                    <a asp-area="Admin" asp-controller="UserReportsViewer" asp-action="Index">
                        <button class="mc-button mc-button--wide">
                            <span class="mc-button__title">Смотреть пользовательские отчёты</span>
                        </button>
                    </a>
                    <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index">
                        <button class="mc-button mc-button--wide"> 
                            <span class="mc-button__title">Менеджер пользователей</span>
                        </button>
                    </a>
                </div>
            </div>

            <div class="section">
                <h2 class="section__title">Фонд проекта</h2>
                <div class="button-container">
                    <a asp-area="Admin" asp-controller="DonationCardsEditor" asp-action="Index">
                        <button class="mc-button mc-button--wide">
                            <span class="mc-button__title">Редактировать карты для пожертвований</span>
                        </button>
                    </a>
                    <a asp-area="Admin" asp-controller="FundManagement" asp-action="Index">
                        <button class="mc-button mc-button--wide">
                            <span class="mc-button__title">Управление фондом</span>
                        </button>
                    </a>
                    <a asp-area="Admin" asp-controller="FundManagement" asp-action="TransactionPurposesIndex">
                        <button class="mc-button mc-button--wide">
                            <span class="mc-button__title">Причины транзакций</span>
                        </button>
                    </a>
                    <a asp-area="Admin" asp-controller="GoalManagement" asp-action="Index">
                        <button class="mc-button mc-button--wide">
                            <span class="mc-button__title">Управление целями</span>
                        </button>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>