@model VyacheslavsMegaWebApp.Data.Entities.CustomCape

<div class="block block--first">
    <div class="container">
        <div class="form-container">
            <form class="form" asp-area="Admin" asp-controller="CapesEditor" asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="form__header">
                    <h2 class="form__title form__title--main">Редактирование плаща «@Model.Name»</h2>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div style="color: #c0392b; font-weight: bold; margin-bottom: 15px; font-size: 14px;">
                        @TempData["Error"]
                    </div>
                }

                <div class="form__body">
                    <div class="form-group">
                        <label class="form-group__label">Текущая текстура</label>
                        <div class="form-group__control">
                            <div style="display: inline-block; width: 44px; height: 70px; background: #1a1a1a; border: 1px solid #333;">
                                <canvas id="editCapeCanvas" width="44" height="70" data-hash="@Model.TextureHash"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label">Название плаща *</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" type="text" name="name" value="@Model.Name" required />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label">Идентификатор (Slug)</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" type="text" name="slug" value="@Model.Slug" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label">Описание плаща</label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" type="text" name="description" value="@Model.Description" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label">Заменить текстуру (.png) <small style="color: #7f8c8d;">(оставьте пустым, если не меняется)</small></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" type="file" name="newImage" accept=".png" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label">Доступ к плащу</label>
                        <div class="form-group__control">
                            <label class="mc-checkbox" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input class="mc-checkbox__input" type="checkbox" name="isPublic" value="true" @(Model.IsPublic ? "checked" : "") />
                                <span class="mc-checkbox__box"></span>
                                <span style="color: #ffffff; font-size: 14px;">Публичный плащ (доступен всем игрокам)</span>
                            </label>
                        </div>
                    </div>

                    <div class="button-container" style="margin-top: 25px;">
                        <button type="submit" class="mc-button">
                            <span class="mc-button__title">Сохранить изменения</span>
                        </button>
                        <a asp-action="Index">
                            <button type="button" class="mc-button">
                                <span class="mc-button__title">Назад к списку</span>
                            </button>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const canvas = document.getElementById('editCapeCanvas');
        if (!canvas) return;
        const hash = canvas.getAttribute('data-hash');
        if (!hash) return;
        const ctx = canvas.getContext('2d');
        ctx.imageSmoothingEnabled = false;

        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = function () {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(img, 1, 1, 10, 16, 2, 3, 40, 64);
        };
        img.src = '/textures/' + hash;
    });
</script>
