@model DownloadButton

<div class="block block--first">
    <div class="container">
        <div class="form-container">
            <form class="form" asp-area="Admin" asp-controller="DownloadButtons" asp-action="ButtonDetails">

                <div class="form__header">
                    <h2 class="form__title form__title--main">@(Model.Id == 0 ? "Добавление" : "Редактирование") кнопки загрузки</h2>
                </div>

                <input type="hidden" asp-for="Id" readonly />

                <div class="form__body">

                    <div class="form__validation-summary" asp-validation-summary="All"></div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Title"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Title">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Url"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Url">
                            </div>
                        </div>
                    </div>

                    <div class="form__row">
                        <div class="form-group form-group--size-50">
                            <div class="form-group__control">
                                <label class="mc-checkbox">
                                    <input class="mc-checkbox__input" asp-for="IsResourceLocal">
                                    <span class="mc-checkbox__box"></span>
                                    <span class="mc-checkbox__label">@Html.DisplayNameFor(x => x.IsResourceLocal)</span>
                                </label>
                            </div>
                        </div>
                        <div class="form-group form-group--size-50">
                            <div class="form-group__control">
                                <label class="mc-checkbox">
                                    <input class="mc-checkbox__input" asp-for="ShowButton">
                                    <span class="mc-checkbox__box"></span>
                                    <span class="mc-checkbox__label">@Html.DisplayNameFor(x => x.ShowButton)</span>
                                </label>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="form__footer">
                    <button class="mc-button mc-button--wide" type="submit">
                        <span class="mc-button__title">Сохранить</span>
                    </button>

                    <p><a asp-area="Admin" asp-controller="DownloadButtons" asp-action="Index">Назад</a></p>
                </div>
            </form>
        </div>
    </div>
</div>
