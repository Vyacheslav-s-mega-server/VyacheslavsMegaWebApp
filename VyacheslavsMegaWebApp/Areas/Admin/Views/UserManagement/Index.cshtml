@using VyacheslavsMegaWebApp.Data.Entities.Identity
@model UserManagerViewModel

<div class="block block--first">
    <div class="container">
        <div class="section">
            <h2 class="section__title section__title--main">Редактор пользователей</h2>

            <div class="mc-table-container">
                <table class="mc-table mc-table--wide">
                    <tr class="mc-table--center-aligment">
                        <td>Имя</td>
                        <td>Email</td>
                        <td>Подтверждён</td>
                        <td>Действия</td>
                    </tr>
                    @foreach (VmsIdentityUser user in Model.Users)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td class="mc-table--center-aligment">
                                <label class="mc-checkbox">
                                    <input class="mc-checkbox__input" type="checkbox" checked="@user.EmailConfirmed" disabled />
                                    <span class="mc-checkbox__box"></span>
                                </label>
                            </td>
                            <td><a asp-action="UserDetails" asp-route-linkId="@user.Id">Подробнее</a></td>
                        </tr>
                    }
                </table>
            </div>

            <p class="back-link">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Назад</a>
            </p>
        </div>
    </div>
</div>

<script src="~/js/navigation-confirmation.js"></script>