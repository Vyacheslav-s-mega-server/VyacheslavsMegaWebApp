@model ServerMediaLink

<div class="block block--first">
    <div class="container">

        <div class="form-container">
            <form class="form" asp-area="Admin" asp-controller="ServerMediaEditor" asp-action="LinkDetails" method="post" enctype="multipart/form-data">

                <div class="form__header">
                    <h2 class="form__title form__title--main">@(Model.Id == 0 ? "Добавление" : "Редактирование") ссылки</h2>
                </div>

                <input type="hidden" asp-for="Id" readonly />
                <input type="hidden" asp-for="LogoFileName" readonly />

                <div class="form__body">

                    <div class="form__validation-summary" asp-validation-summary="All"></div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Url"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Url">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Content"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Content">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Description"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Description">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="LogoFileName"></label>
                        <div class="mc-file">
                            <div class="mc-file__preview">
                                @if (Model.HasLogo)
                                {
                                    <img src="~/@Model.LogoFullPath" id="imagePreview" />
                                }
                                else
                                {
                                    <img id="imagePreview" style="display:none" />
                                }
                            </div>

                            <div class="mc-file__controls">
                                <input class="mc-file__input"
                                       type="file"
                                       accept="image/*"
                                       name="linkIcon"
                                       id="linkIcon"
                                       onchange="previewImage(event)" />

                                <button class="mc-button mc-button--wide"
                                        type="button"
                                        onclick="document.getElementById('linkIcon').click()">
                                    <span class="mc-button__title">Выбрать файл</span>
                                </button>

                                <div class="mc-file__filename" id="fileName">
                                    Файл не выбран
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="form-group__control">
                            <label class="mc-checkbox">
                                <input class="mc-checkbox__input" asp-for="ShowLink">
                                <span class="mc-checkbox__box"></span>
                                <span class="mc-checkbox__label">@Html.DisplayNameFor(x => x.ShowLink)</span>
                            </label>
                        </div>
                    </div>

                </div>

                <div class="form__footer">
                    <button class="mc-button mc-button--wide" type="submit">
                        <span class="mc-button__title">Сохранить</span>
                    </button>

                    <p><a asp-area="Admin" asp-controller="ServerMediaEditor" asp-action="Index">Назад</a></p>
                </div>

            </form>
        </div>
    </div>
</div>

<script src="~/js/form-image-previewer.js"></script>